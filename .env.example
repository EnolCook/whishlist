SESSION_SECRET=

# Lien Payment Link Stripe (« Soutenir le projet ») — visible hero + footer (hors homepage).
# SUPPORT_URL=https://buy.stripe.com/…

# URL publique canonique (prod) — liens reset / invite / partage. Évite le Host-header poisoning.
# APP_ORIGIN=https://ohyoushouldnt.app

# Reset de mot de passe (optionnel — sinon lien dans data/password-reset.log)
RESEND_API_KEY=
MAIL_FROM=
# Afficher le lien reset dans l'UI si mail KO — DEV UNIQUEMENT (ignoré en production).
# PASSWORD_RESET_SHOW_LINK=1
# Envoi simulé : e-mails écrits dans data/mail.log, validation des adresses active — DEV UNIQUEMENT (ignoré en production).
# MAIL_DRY_RUN=1
# Envoi par un serveur SMTP local (MailDev, suite e2e) au lieu de Resend — DEV UNIQUEMENT (ignoré en production).
# MAIL_SMTP_URL=smtp://localhost:1025

# Mesure d'audience Umami, optionnelle. Sans les deux valeurs, aucun script n'est chargé.
# UMAMI_WEBSITE_ID=
# UMAMI_URL=https://analytics.example

# Enrichissement produit depuis une URL (optionnel — Gemini prioritaire si les deux sont set)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini


# API pour une app mobile : origines web autorisées en plus du site, séparées par des virgules (optionnel).
# Sans valeur, seuls le site et les clients natifs (sans en-tête Origin) appellent l'API.
# API_ALLOWED_ORIGINS=capacitor://localhost,https://localhost
